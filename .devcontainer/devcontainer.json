{
  "name": "UrbanFlow (Spark local mode + opt-in Big Data stacks)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "forwardPorts": [8501, 19870, 18088, 19888, 20002, 16010, 16030, 3000, 9090, 9308, 4050],
  "portsAttributes": {
    "8501": { "label": "UrbanFlow dashboard", "onAutoForward": "openPreview" },
    "19870": { "label": "HDFS NameNode UI (make hadoop-up)" },
    "18088": { "label": "YARN ResourceManager UI (make hadoop-up)" },
    "19888": { "label": "MapReduce JobHistory UI (make hadoop-up)" },
    "20002": { "label": "HiveServer2 UI (make hadoop-up)" },
    "16010": { "label": "HBase HMaster UI (make hbase-up)" },
    "16030": { "label": "HBase RegionServer UI (make hbase-up)" },
    "3000": { "label": "Grafana (monitoring stack)" },
    "9090": { "label": "Prometheus (monitoring stack)" },
    "9308": { "label": "kafka-exporter metrics (streaming stack)" },
    "4050": { "label": "Spark streaming UI + metrics (make stream-run)" }
  },
  "postCreateCommand": "make setup && make check",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  }
}
