    {
      "type": "table",
      "title": "Every scrape target",
      "description": "One row per endpoint Prometheus scrapes. DOWN just means that stack is not started, unless you expected it to be.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "custom": {
            "cellOptions": {
              "type": "color-text"
            }
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "module": true
            },
            "renameByName": {
              "Value": "state",
              "instance": "endpoint"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "stack"
          }
        ]
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 14
