{
  "uid": "urbanflow-overview",
  "title": "UrbanFlow: Overview",
  "description": "Which stacks are up, and CPU / memory / network per container.",
  "tags": [
    "urbanflow"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Compose project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_memory_working_set_bytes, compose_project)",
          "refId": "project"
        },
        "regex": "/urbanflow.*/",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": "urbanflow.*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "urbanflow"
      ],
      "asDropdown": true,
      "title": "UrbanFlow dashboards",
      "includeVars": false,
      "keepTime": true
    }
  ],
