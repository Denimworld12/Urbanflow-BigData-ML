    {
      "type": "stat",
      "title": "Hadoop core (HDFS, YARN, Hive)",
      "description": "Scrape targets answering (up) out of those configured (expected). make hadoop-up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(up{stack=\"hadoop\"})",
          "refId": "A",
          "legendFormat": "up"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(up{stack=\"hadoop\"})",
          "refId": "B",
          "legendFormat": "expected"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "noValue": "stack not running",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
